# DevEco Studio and local SDK configuration
.idea/
local.properties

# Hvigor and analysis caches
.hvigor/
.appanalyzer/
.sdk-proxy/

# Build and test output
**/build/
.pytest_cache/

# Logs and JVM crash reports
*.log
hs_err_pid*.log

# OS metadata
.DS_Store
Thumbs.db

# Cloud runtime state and local credentials
cloud/data/
cloud/backend/data/
cloud/mosquitto/data/
cloud/mosquitto/certs/*
!cloud/mosquitto/certs/.gitkeep
cloud/nginx/certs/*
!cloud/nginx/certs/.gitkeep
cloud/**/__pycache__/
cloud/**/.pytest_cache/
cloud/**/*.pyc
